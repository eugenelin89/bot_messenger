[Unit]
Description=BotSquad local AI headquarters
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=botsquad
Group=botsquad
WorkingDirectory=/opt/botsquad
Environment=NODE_ENV=production
Environment=BOT_DATA_DIR=/var/lib/botsquad
Environment=HOME=/var/lib/botsquad
Environment=CODEX_HOME=/var/lib/botsquad/.codex
Environment=CODEX_BIN=/opt/botsquad/node_modules/.bin/codex
Environment=PATH=/opt/botsquad-runtime/node/bin:/usr/bin:/bin
Environment=PORT=4310
EnvironmentFile=/etc/botsquad/deployment
EnvironmentFile=-/etc/botsquad/environment
ExecStart=/opt/botsquad-runtime/node/bin/node /opt/botsquad/dist/src/main.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=25
KillMode=control-group
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/botsquad
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
CapabilityBoundingSet=
TasksMax=256
LimitNOFILE=4096
# User/mount/PID/network namespaces remain available to bubblewrap.
# V8 JIT needs executable memory; Codex needs outbound HTTPS.

[Install]
WantedBy=multi-user.target
