    "validate:prompt01": "npm run build && node dist/scripts/real-e2e.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@openai/codex": "0.157.0"
  }
}
