{
  "name": "botsquad",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.10.0 <25"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "start": "node dist/src/main.js",
    "dev": "npm run build && npm start",
    "codex:preflight": "npm run build && node dist/scripts/codex-preflight.js",
    "validate:real": "npm run build && node dist/scripts/real-engineering.js",
    "validate:projects": "npm run build && node dist/scripts/real-projects.js",
    "validate:prompt01": "npm run build && node dist/scripts/real-e2e.js",
    "demo:tutorial": "npm run build && node dist/scripts/demo-operator/run.js",
    "validate:conversations": "npm run build && node scripts/conversations/acceptance.mjs",
    "validate:discussions": "npm run build && node scripts/discussions/acceptance.mjs",
    "contracts:generate": "node scripts/investment-contracts/generate.mjs",
    "contracts:check": "node scripts/investment-contracts/generate.mjs --check",
    "contracts:test": "npm run contracts:check && npm run build && node --test dist/test/investment-contracts.test.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "json-schema-to-typescript": "15.0.4",
    "playwright": "1.63.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@openai/codex": "0.157.0",
    "playwright-core": "1.63.0",
    "canonicalize": "2.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsonc-parser": "3.3.1"
  }
}
